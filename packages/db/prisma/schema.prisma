// Colli-BoBi 신규 테이블. 구독자/구독(Subscriber/Subscription)은
// BoBi 기존 시스템 소유 → 여기 모델 없음. Worker C 의 read 어댑터로만 접근.
// enum 값은 @colli/contracts 의 도메인 상수와 1:1 정렬한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── enums (contracts 와 정렬) ───────────────────────────────────
enum Intent {
  usage
  billing
  tech_error
  upgrade
  churn
  new_signup
  other
}

enum Emotion {
  neutral
  angry
  urgent
  confused
}

enum CallDirection {
  inbound
  outbound
}

enum CallOutcome {
  kb_answered
  ticket_created
  transferred
  callback_queued
  selfservice_sent
  abandoned
  other
}

enum SpeakerRole {
  caller
  agent
  system
}

enum TicketSeverity {
  low
  medium
  high
  critical
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum CallbackUrgency {
  low
  normal
  high
}

enum CallbackStatus {
  queued
  scheduled
  completed
  cancelled
}

enum NotificationStatus {
  queued
  sent
  delivered
  failed
}

// ── 통화 세션 ───────────────────────────────────────────────────
model CallSession {
  id            String        @id @default(cuid())
  // ClawOps 콜 식별자(외부)
  clawopsCallId String        @unique
  direction     CallDirection @default(inbound)
  fromNumber    String // 발신번호(E.164)
  toNumber      String // 수신 070 번호
  // 본인확인된 구독자(외부 id, 미확인이면 null)
  subscriberId  String?
  intent        Intent?
  emotion       Emotion?
  outcome       CallOutcome?
  summary       String?
  // 실패/에러 사유(관측성 GUARDRAIL #7)
  failureReason String?
  startedAt     DateTime      @default(now())
  answeredAt    DateTime?
  endedAt       DateTime?
  durationSec   Int?
  recordingUrl  String?

  transcripts       Transcript[]
  tickets           Ticket[]
  notifications     Notification[]
  consentRecords    ConsentRecord[]
  callbackRequests  CallbackRequest[]
  toolInvocations   ToolInvocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriberId])
  @@index([intent])
  @@index([startedAt])
}

// ── 전사 세그먼트 ───────────────────────────────────────────────
model Transcript {
  id            String      @id @default(cuid())
  callSessionId String
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  role          SpeakerRole
  // Worker F 의 PII 마스킹을 거친 텍스트만 저장(카드/계좌/CVC 금지)
  text          String
  // 세그먼트 시작 오프셋(ms)
  startMs       Int?
  createdAt     DateTime    @default(now())

  @@index([callSessionId])
}

// ── 티켓 ────────────────────────────────────────────────────────
model Ticket {
  id            String         @id @default(cuid())
  callSessionId String?
  callSession   CallSession?   @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  subscriberId  String // 외부 구독자 id
  category      Intent
  summary       String
  severity      TicketSeverity @default(medium)
  status        TicketStatus   @default(open)
  assignee      String? // 개발/CS 담당
  resolution    String?
  resolvedAt    DateTime?

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriberId])
  @@index([status])
  @@index([category])
}

// ── 지식베이스 ──────────────────────────────────────────────────
model KnowledgeItem {
  id        String   @id @default(cuid())
  category  Intent
  question  String
  answer    String
  // 키워드/태그(간단 매칭). 임베딩은 별도 컬럼/스토어로 확장 가능.
  keywords  String[] @default([])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ── 알림(카카오 알림톡) ─────────────────────────────────────────
model Notification {
  id            String             @id @default(cuid())
  callSessionId String?
  callSession   CallSession?       @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  ticketId      String?
  ticket        Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  templateKey   String // KakaoTemplateKey
  toNumber      String
  vars          Json
  status        NotificationStatus @default(queued)
  providerMsgId String? // 대행사 메시지 id
  attempts      Int                @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([templateKey])
}

// ── 동의 기록(고지·녹음 동의, GUARDRAIL #3) ─────────────────────
model ConsentRecord {
  id            String      @id @default(cuid())
  callSessionId String
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  // 고지 유형: ai_disclosure(AI응대) / recording(녹음)
  kind          String
  granted       Boolean
  // 고지 멘트 텍스트/버전(감사)
  disclosureText String?
  createdAt     DateTime    @default(now())

  @@index([callSessionId])
}

// ── 콜백 요청 큐 ────────────────────────────────────────────────
model CallbackRequest {
  id            String          @id @default(cuid())
  callSessionId String?
  callSession   CallSession?    @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  subscriberId  String?
  phone         String? // subscriberId 없을 때
  summary       String
  urgency       CallbackUrgency @default(normal)
  status        CallbackStatus  @default(queued)
  scheduledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([urgency])
}

// ── tool 호출 trace(관측성 GUARDRAIL #7) ────────────────────────
model ToolInvocation {
  id            String      @id @default(cuid())
  callSessionId String
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  toolName      String
  // 마스킹된 파라미터/결과 요약만 저장
  paramsSummary Json?
  ok            Boolean
  errorCode     String?
  latencyMs     Int?
  createdAt     DateTime    @default(now())

  @@index([callSessionId])
  @@index([toolName])
}
