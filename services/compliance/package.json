{
  "name": "@colli/compliance",
  "version": "0.1.0",
  "private": true,
  "description": "고지·동의 · PII 암호화/마스킹 · 결제정보 차단 가드 · 감사 로그 (Worker F, 횡단)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --filter @colli/contracts build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colli/contracts": "workspace:*",
    "@colli/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
