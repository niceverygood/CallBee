# ClawOps (실값은 루트 .env / prototypes/clawops-quickstart/.env 참조)
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
# 인바운드 070 번호 (tenants/resolve 의 toNumber 로도 사용)
CLAWOPS_070_NUMBER=07052361037

# OpenAI Realtime
OPENAI_API_KEY=

# apps/api (NestJS)
API_BASE_URL=http://localhost:3001
# /ingest/* 호출 시 x-gateway-secret 헤더 값 (apps/api 의 GATEWAY_SHARED_SECRET 과 일치해야 함)
GATEWAY_SHARED_SECRET=dev-gateway-secret
