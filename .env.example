# ── Database (packages/db) ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colli_bobi?schema=public"

# ── Redis (세션 상태) ───────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── ClawOps (전화망·음성, Worker A) ─────────────────────────────
CLAWOPS_API_KEY=""
CLAWOPS_ACCOUNT_ID=""
CLAWOPS_070_NUMBER=""
CLAWOPS_WEBHOOK_SECRET=""

# ── LLM (Voice Agent, 기본 OpenAI Realtime) ─────────────────────
OPENAI_API_KEY=""

# ── 카카오 알림톡 (비즈메시지 대행, Worker D) ───────────────────
KAKAO_ALIMTALK_API_KEY=""
KAKAO_SENDER_KEY=""

# ── 카카오 로그인 (콘솔 OAuth) ───────────────────────────────────
# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키.
KAKAO_REST_API_KEY=""
# Kakao Developers 에 등록한 Redirect URI. 여러 개면 쉼표로 구분.
KAKAO_REDIRECT_URIS="http://localhost:5175/auth/kakao/callback"
# Client secret 을 활성화한 경우에만 입력.
KAKAO_CLIENT_SECRET=""
# apps/console/.env.local 에도 같은 REST API 키를 Vite 공개 env 로 넣는다.
VITE_KAKAO_REST_API_KEY=""
VITE_KAKAO_REDIRECT_URI="http://localhost:5175/auth/kakao/callback"

# ── BoBi 기존 구독 시스템 read 어댑터 (Worker C) ────────────────
BOBI_API_BASE_URL=""
BOBI_API_KEY=""

# ── 보안 (Worker F, PII 암호화) ─────────────────────────────────
PII_ENCRYPTION_KEY=""

NODE_ENV="development"
