{
  "name": "@colli/voice",
  "version": "0.1.0",
  "private": true,
  "description": "ClawOps 인바운드 세션 핸들러 + 웹훅 라우트 + Voice Agent 어댑터 (Worker A)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
